; Arithmetic and numeric comparison take numbers and named constants such as pi.
; A string or an expression is not a number, whatever its length.
!(test (+ 1 2) 3)
!(test (* 2.5 2) 5.0)
!(test (< 1 2) True)
!(test (max 3 7) 7)
!(test (< 3 (+ pi 0)) True)
!(test (isinf-math inf) True)
!(test (let (Error $e $c) (catch (+ 1 "s")) raised) raised)
!(test (let (Error $e $c) (catch (+ 1 "st")) raised) raised)
!(test (let (Error $e $c) (catch (+ 1 (5))) raised) raised)
!(test (let (Error $e $c) (catch (< 1 "s")) raised) raised)
!(test (let (Error $e $c) (catch (max 1 "s")) raised) raised)
!(test (let (Error $e $c) (catch (+ 1 a)) raised) raised)
!(test (let (Error $e $c) (catch (- "s" 1)) raised) raised)
!(test (let (Error $e $c) (catch (* (5) 2)) raised) raised)
!(test (let (Error $e $c) (catch (<= 1 "s")) raised) raised)
!(test (let (Error $e $c) (catch (sqrt-math "s")) raised) raised)
!(test (let (Error $e $c) (catch (isnan-math "s")) raised) raised)
!(test (let (Error $e $c) (catch (random-float 0 "s")) raised) raised)
!(test (let (Error $e $c) (catch (min-atom (1 "s" 3))) raised) raised)
!(test (let (Error $e $c) (catch (max-atom ((5)))) raised) raised)
!(test (let (Error $e $c) (catch (min-atom ("s"))) raised) raised)
